# Email backend (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=your-email@example.com
# Use a verified sender/domain in Resend. For testing, follow Resend's current sender setup guidance.
CONTACT_FROM_EMAIL=Portfolio <portfolio@your-verified-domain.com>

# Public contact details
NEXT_PUBLIC_CONTACT_EMAIL=your-email@example.com
# Digits only, international format. Example for Sri Lanka: 947XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=947XXXXXXXX
